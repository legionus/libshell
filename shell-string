if [ -z "${__included_shell_string-}" ]; then
__included_shell_string=1

### Creates a mask of equal length string.
### The mask is shorter than the string by one character unless
### the full-length flag is present, in which case it has the same
### length as the string.
### Usage: fill_mask var str [full-length]
fill_mask()
{
	local m= p='?' n
	n="${#2}"
	[ "$#" -eq 2 ] && n=$(( n - 1 ))

	# Build the mask by doubling the pattern: each round handles two
	# bits of the requested length, so the loop runs log2(n) times
	# and the total amount of copied data is O(n) instead of the
	# O(n^2) of growing the mask one character at a time.
	while [ "$n" -gt 0 ]; do
		if [ $(( n % 2 )) -eq 1 ]; then
			m="$m$p"
		fi
		n=$(( n / 2 ))
		p="$p$p"
	done

	eval "$1=\"$m\""
}

__shell_is_bash()
{
	[ -n "${BASH-}" ] && [ -n "${BASH_VERSION-}" ]
}

__shell_is_ksh()
{
	[ -n "${KSH_VERSION-}" ]
}

__shell_string_foreach=0

# Iteration primitives for shells with `${parameter:offset:length}'
# expansion (bash, ksh).
__shell_string_foreach_condition_modern()
{
	eval "set -- \"\${${1}_i-}\" \"\${${1}_line-}\""

	[ $1 -lt "${#2}" ] ||
		return 1
}

__shell_string_foreach_char_modern()
{
	eval "$1=\"\${${2}_line:\$${2}_i:1}\""
}

__shell_string_foreach_iter_modern()
{
	eval "${1}_i=\$(( \$${1}_i + 1 ))"
}

# Iteration primitives for the remaining shells (dash, ash, ...).
# Each character is obtained by trimming the rest of the line and
# removing it back from it:
#	rest="${line#?}"
#	c="${line%"$rest"}"
# The quotes make the rest a literal string, so neither glob
# characters nor any code embedded in the walked string can
# change the meaning of the expansion.
__shell_string_foreach_condition_plain()
{
	eval "set -- \"\${${1}_line-}\""

	[ -n "$1" ] ||
		return 1
}

__shell_string_foreach_char_plain()
{
	local __rest
	eval "__rest=\"\${${2}_line#?}\""
	eval "$1=\"\${${2}_line%\"\$__rest\"}\""
}

__shell_string_foreach_iter_plain()
{
	eval "${1}_line=\"\${${1}_line#?}\""
}

# Bind the generic iteration functions to the implementation matching
# the current shell.  The shell cannot change during the session, so
# the test is performed once here instead of on every iteration.
if ! __shell_is_bash && ! __shell_is_ksh; then
	__shell_string_foreach_plain=1

	__shell_string_foreach_condition() { __shell_string_foreach_condition_plain "$@"; }
	__shell_string_foreach_char()      { __shell_string_foreach_char_plain "$@"; }
	__shell_string_foreach_iter()      { __shell_string_foreach_iter_plain "$@"; }
else
	__shell_string_foreach_condition() { __shell_string_foreach_condition_modern "$@"; }
	__shell_string_foreach_char()      { __shell_string_foreach_char_modern "$@"; }
	__shell_string_foreach_iter()      { __shell_string_foreach_iter_modern "$@"; }
fi

# Usage: __shell_string_foreach_prepare ctxvar str
__shell_string_foreach_prepare()
{
	set -- "$@" "__shell_string_foreach_${__shell_string_foreach:-0}"
	eval "${3}_line=\"\$2\""
	eval "${3}_i=0"

	eval "$1=\"\$3\""
	__shell_string_foreach=$(( ${__shell_string_foreach:-0} + 1 ))
}

# Usage: __shell_string_foreach_finish ctxvar
__shell_string_foreach_finish()
{
	unset "${1}_line"
	unset "${1}_i"
}

# Usage: __shell_string_foreach_continue ctxvar
__shell_string_foreach_continue()
{
	if ! __shell_string_foreach_condition "$1"; then
		__shell_string_foreach_finish "$1"
		return 1
	fi
}

fi #__included_shell_string
